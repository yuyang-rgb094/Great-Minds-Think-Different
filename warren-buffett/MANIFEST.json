    },
    "08-few-shot-examples": {
      "description": "Example interactions for training",
      "files": ["few-shot-examples.json"]
    },
    "09-knowledge-base": {
      "description": "Biographical and historical information",
      "files": ["biography-timeline.json", "berkshire-history.json", "key-investments.json"]
    },
    "10-quality-control": {
      "description": "Validation and anti-hallucination guidelines",
      "files": ["validation-checklist.json", "anti-hallucination-guide.json"]
    },
    "11-embeddings": {
      "description": "Vector embeddings for semantic search",
      "files": ["embedding_config.json", "chunk_statistics.json", "search_examples.json", "chunks_data.json"],
