{
  "metadata": {
    "title": {
      "en": "Consistency Rules",
      "zh": "一致性规则"
    },
    "description": {
      "en": "Rules for maintaining consistency across the corpus in translation, style, formatting, and source attribution",
      "zh": "维护语料库在翻译、风格、格式和来源引用方面一致性的规则"
    },
    "version": "1.0.0",
    "last_updated": "2025-06-01",
    "category": "quality_control"
  },
  "translation_consistency": {
    "name": {
      "en": "Translation Consistency",
      "zh": "翻译一致性"
    },
    "key_terminology_glossary": [
      {"en": "Full Self-Driving", "zh": "完全自动驾驶", "notes": "非'全自动驾驶'"},
      {"en": "Autopilot", "zh": "自动辅助驾驶", "notes": "Tesla标准功能"},
      {"en": "Neuralink", "zh": "Neuralink", "notes": "保留品牌名"},
      {"en": "The Boring Company", "zh": "The Boring Company", "notes": "保留品牌名"},
      {"en": "SpaceX", "zh": "SpaceX", "notes": "保留品牌名"},
      {"en": "Tesla", "zh": "特斯拉", "notes": "首次出现可保留英文"},
      {"en": "xAI", "zh": "xAI", "notes": "保留品牌名"},
      {"en": "Grok", "zh": "Grok", "notes": "保留产品名"},
      {"en": "Grok Heavy", "zh": "Grok Heavy", "notes": "2025年新模型"},
      {"en": "Optimus", "zh": "Optimus", "notes": "Tesla机器人"},
      {"en": "Cybertruck", "zh": "Cybertruck", "notes": "保留产品名"},
      {"en": "Starship", "zh": "星舰", "notes": "SpaceX火箭"},
      {"en": "Falcon", "zh": "猎鹰", "notes": "猎鹰9号/重型"},
      {"en": "Dragon", "zh": "龙飞船", "notes": "Crew Dragon等"},
      {"en": "DOGE", "zh": "DOGE/政府效率部", "notes": "首次出现需全称"},
      {"en": "Department of Government Efficiency", "zh": "政府效率部", "notes": "全称"},
      {"en": "Mars Colony", "zh": "火星殖民地", "notes": "定居点概念"},
      {"en": "Multiplanetary", "zh": "多行星物种", "notes": "成为多行星物种"},
      {"en": "Sustainable Energy", "zh": "可持续能源", "notes": "能源概念"},
      {"en": "Artificial General Intelligence", "zh": "通用人工智能", "notes": "AGI全称"},
      {"en": "AGI", "zh": "通用人工智能/AGI", "notes": "根据上下文"},
      {"en": "Brain-Computer Interface", "zh": "脑机接口", "notes": "BCI全称"},
      {"en": "BCI", "zh": "脑机接口/BCI", "notes": "根据上下文"},
      {"en": "First Principles", "zh": "第一性原理", "notes": "思维方法"},
      {"en": "Manufacturing", "zh": "制造业/生产制造", "notes": "根据上下文"},
      {"en": "Supply Chain", "zh": "供应链", "notes": "商业术语"},
      {"en": "Vertical Integration", "zh": "垂直整合", "notes": "商业策略"},
      {"en": "Economies of Scale", "zh": "规模经济", "notes": "经济学术语"}
    ],
    "company_product_name_rules": {
      "rule_1_2_1": {
        "name": {
          "en": "Brand Name Preservation",
          "zh": "品牌名保留"
        },
        "description": {
          "en": "All company brand names retain original English. Chinese explanation may be added in parentheses on first occurrence.",
          "zh": "所有公司品牌名保留原始英文。首次出现时可在括号内添加中文说明。"
        },
        "example": "xAI (埃隆·马斯克的人工智能公司) / xAI (Elon Musk's AI company)"
      },
      "rule_1_2_2": {
        "name": {
          "en": "Product Name Handling",
          "zh": "产品名处理"
        },
        "description": {
          "en": "Products with official Chinese names use official translations. Products without official Chinese names retain English.",
          "zh": "有官方中文名的产品使用官方译名。无官方中文名的产品保留英文。"
        },
        "examples": [
          {"en": "Model S", "zh": "Model S", "note": "保留"},
          {"en": "Cybertruck", "zh": "Cybertruck", "note": "保留"}
        ]
      },
      "rule_1_2_3": {
        "name": {
          "en": "Technical Terminology Uniformity",
          "zh": "技术术语统一"
        },
        "description": {
          "en": "Technical acronyms must be expanded on first occurrence. Subsequent usage may use acronym or full form based on context.",
          "zh": "技术缩写首次出现必须展开。后续使用可根据上下文选择缩写或全称。"
        },
        "example": "Full Self-Driving (FSD) 首次出现，后续可用 FSD"
      }
    },
    "common_expressions": [
      {"en": "To be honest", "recommended_zh": "说实话/老实说", "avoid": "诚实地说"},
      {"en": "The thing is", "recommended_zh": "问题是/关键是", "avoid": "事情是"},
      {"en": "At the end of the day", "recommended_zh": "归根结底/说到底", "avoid": "在一天结束时"},
      {"en": "Going forward", "recommended_zh": "今后/未来", "avoid": "向前进"},
      {"en": "In terms of", "recommended_zh": "就...而言/在...方面", "avoid": "在...条款中"},
      {"en": "Kind of", "recommended_zh": "有点/某种程度上", "avoid": "种类"},
      {"en": "Sort of", "recommended_zh": "算是/某种程度上", "avoid": "分类"},
      {"en": "Pretty much", "recommended_zh": "基本上/差不多", "avoid": "非常漂亮"},
      {"en": "I mean", "recommended_zh": "我是说/我的意思是", "avoid": ""},
      {"en": "You know", "recommended_zh": "你知道/要知道", "avoid": ""},
      {"en": "Right?", "recommended_zh": "对吧？/对吗？", "avoid": "正确？"},
      {"en": "Basically", "recommended_zh": "基本上/本质上", "avoid": "基础地"},
      {"en": "Literally", "recommended_zh": "字面意义上/确实", "avoid": "文学地"},
      {"en": "Figuratively", "recommended_zh": "比喻意义上", "avoid": "形象地"},
      {"en": "Insane", "recommended_zh": "疯狂的/不可思议的", "avoid": "疯癫的"},
      {"en": "Crazy", "recommended_zh": "疯狂的/离谱的", "avoid": "精神错乱的"},
      {"en": "Next level", "recommended_zh": "下一个层次/更高水平", "avoid": "下一关"},
      {"en": "Game changer", "recommended_zh": "游戏规则改变者/颠覆者", "avoid": "游戏改变者"},
      {"en": "Paradigm shift", "recommended_zh": "范式转变/模式转变", "avoid": "范式转移"}
    ]
  },
  "style_marker_consistency": {
    "name": {
      "en": "Style Marker Consistency",
      "zh": "风格标记一致性"
    },
    "catchphrase_rules": {
      "rule_2_1_1": {
        "catchphrase": "Literally",
        "usage": {
          "en": "Used to emphasize truthfulness, not literal meaning",
          "zh": "用于强调真实性，非字面意义"
        },
        "translations": ["字面意义上", "确实", "真的"],
        "note": "保持原文中的强调语气"
      },
      "rule_2_1_2": {
        "catchphrase": "The thing is",
        "usage": {
          "en": "Used to introduce key points or transitions",
          "zh": "用于引出关键观点或转折"
        },
        "translations": ["问题是", "关键是", "事实是"],
        "note": "保持口语化风格"
      },
      "rule_2_1_3": {
        "catchphrase": "Fundamentally",
        "usage": {
          "en": "Used to emphasize root causes or essence",
          "zh": "用于强调根本原因或本质"
        },
        "translations": ["从根本上", "本质上", "归根结底"],
        "note": "保持哲学性思考语气"
      },
      "rule_2_1_4": {
        "catchphrase": "Insane/Next level",
        "usage": {
          "en": "Used to express strong emotions or praise",
          "zh": "用于表达强烈情感或赞美"
        },
        "translations": ["疯狂的", "不可思议的", "下一个层次"],
        "note": "保持热情夸张的语气"
      }
    },
    "emotion_markers": [
      {"type": "excitement", "en_example": "This is insane!", "zh_translation": "这太疯狂了！/太不可思议了！", "context": "突破性进展"},
      {"type": "emphasis", "en_example": "Literally", "zh_translation": "字面意义上/确实", "context": "强调真实性"},
      {"type": "thinking", "en_example": "Um, like", "zh_translation": "嗯，就像", "context": "思考停顿"},
      {"type": "humor", "en_example": "lol, haha", "zh_translation": "哈哈", "context": "轻松时刻"},
      {"type": "sarcasm", "en_example": "Obviously...", "zh_translation": "显然...", "context": "反讽表达"},
      {"type": "certainty", "en_example": "Absolutely", "zh_translation": "绝对/完全", "context": "肯定回答"},
      {"type": "uncertainty", "en_example": "I think, probably", "zh_translation": "我想，可能", "context": "推测性陈述"}
    ],
    "technical_enthusiasm_rules": {
      "rule_2_3_1": {
        "name": {
          "en": "Technical Detail Description",
          "zh": "技术细节描述"
        },
        "description": {
          "en": "Maintain precise descriptions of technical specifications. Chinese translation maintains professional terminology accuracy. Preserve excited tone about technical breakthroughs.",
          "zh": "保持对技术规格的精确描述。中文翻译保持专业术语准确性。保留对技术突破的兴奋语气。"
        }
      },
      "rule_2_3_2": {
        "name": {
          "en": "Future Vision Expression",
          "zh": "未来愿景表达"
        },
        "description": {
          "en": "Maintain enthusiastic expression about grand goals. Chinese translation maintains inspirational and infectious quality. Preserve core vision statements.",
          "zh": "保持对宏大目标的热情表达。中文翻译保持激励性和感染力。保留核心愿景表述。"
        }
      }
    }
  },
  "date_format_consistency": {
    "name": {
      "en": "Date Format Consistency",
      "zh": "日期格式一致性"
    },
    "iso_8601_standard": {
      "rule_3_1_1": {
        "name": {
          "en": "Standard Date Format",
          "zh": "标准日期格式"
        },
        "format": "YYYY-MM-DD",
        "example": "2025-06-01"
      },
      "rule_3_1_2": {
        "name": {
          "en": "Date-Time Format",
          "zh": "日期时间格式"
        },
        "format": "YYYY-MM-DDTHH:MM:SS",
        "example": "2025-06-01T14:30:00"
      },
      "rule_3_1_3": {
        "name": {
          "en": "Timezone Handling",
          "zh": "时区处理"
        },
        "description": {
          "en": "Prefer UTC time with Z suffix, or use local time with timezone offset",
          "zh": "优先使用UTC时间，标注Z后缀。或使用本地时间+时区偏移。"
        },
        "examples": ["2025-06-01T14:30:00Z", "2025-06-01T14:30:00-08:00"]
      }
    },
    "date_range_formats": [
      {"scenario": "日期范围", "format": "YYYY-MM-DD/YYYY-MM-DD", "example": "2025-01-01/2025-01-31"},
      {"scenario": "模糊日期", "format": "YYYY-MM 或 YYYY", "example": "2025-06 或 2025"},
      {"scenario": "季度", "format": "YYYY-QN", "example": "2025-Q2"},
      {"scenario": "财年", "format": "FYYYYY", "example": "FY2025"}
    ],
    "relative_time_rule": {
      "rule_3_3_1": {
        "name": {
          "en": "Relative Time Standardization",
          "zh": "相对时间标准化"
        },
        "description": {
          "en": "Avoid vague terms like 'recently', 'not long ago'. Convert to specific dates or clear time ranges.",
          "zh": "避免使用模糊的'最近'、'不久前'。转换为具体日期或明确的时间范围。"
        },
        "example": "将'最近'转换为'2025年5月'或'过去两周'"
      }
    }
  },
  "id_format_consistency": {
    "name": {
      "en": "ID Format Consistency",
      "zh": "ID格式一致性"
    },
    "standard_format": {
      "rule_4_1_1": {
        "name": {
          "en": "Standard ID Format",
          "zh": "标准ID格式"
        },
        "format": "{type}-{YYYY}-{sequence}",
        "examples": ["tweet-2025-001", "interview-2025-042"]
      },
      "rule_4_1_2": {
        "name": {
          "en": "Type Prefix Definitions",
          "zh": "类型前缀定义"
        },
        "prefixes": [
          {"type": "X/Twitter 推文", "prefix": "tweet", "example": "tweet-2025-001"},
          {"type": "采访", "prefix": "interview", "example": "interview-2025-001"},
          {"type": "财报电话会议", "prefix": "earnings", "example": "earnings-2025-001"},
          {"type": "演讲/主旨发言", "prefix": "keynote", "example": "keynote-2025-001"},
          {"type": "播客", "prefix": "podcast", "example": "podcast-2025-001"},
          {"type": "新闻发布会", "prefix": "press", "example": "press-2025-001"},
          {"type": "法律文件", "prefix": "legal", "example": "legal-2025-001"},
          {"type": "邮件/内部备忘录", "prefix": "email", "example": "email-2025-001"},
          {"type": "书籍/文章", "prefix": "book", "example": "book-2025-001"},
          {"type": "法庭证词", "prefix": "testimony", "example": "testimony-2025-001"}
        ]
      },
      "rule_4_1_3": {
        "name": {
          "en": "Sequence Number Rules",
          "zh": "序列号规则"
        },
        "description": {
          "en": "Restart numbering from 001 each year. Use 3 digits with leading zeros.",
          "zh": "每年从001开始重新编号。使用3位数字，不足补零。"
        },
        "examples": ["001", "042", "123", "999"]
      }
    },
    "special_formats": {
      "rule_4_2_1": {
        "name": {
          "en": "Thematic Series IDs",
          "zh": "主题系列ID"
        },
        "format": "{type}-{topic}-{YYYY}-{sequence}",
        "examples": ["interview-doge-2025-001", "tweet-ai-2025-015"]
      },
      "rule_4_2_2": {
        "name": {
          "en": "Multi-part IDs",
          "zh": "多部分ID"
        },
        "format": "{base-id}-part{N}",
        "examples": ["interview-2025-001-part1", "interview-2025-001-part2"]
      }
    }
  },
  "category_tag_consistency": {
    "name": {
      "en": "Category/Tag Consistency",
      "zh": "分类/标签一致性"
    },
    "controlled_vocabulary": {
      "main_categories": [
        {"id": "tech", "en": "Technology", "zh": "技术"},
        {"id": "business", "en": "Business", "zh": "商业"},
        {"id": "space", "en": "Space Exploration", "zh": "太空探索"},
        {"id": "ai", "en": "Artificial Intelligence", "zh": "人工智能"},
        {"id": "energy", "en": "Energy", "zh": "能源"},
        {"id": "transportation", "en": "Transportation", "zh": "交通"},
        {"id": "politics", "en": "Politics", "zh": "政治"},
        {"id": "society", "en": "Society", "zh": "社会"},
        {"id": "personal", "en": "Personal", "zh": "个人"},
        {"id": "philosophy", "en": "Philosophy", "zh": "哲学"}
      ],
      "subcategories": [
        {"parent": "tech", "id": "tesla", "en": "Tesla", "zh": "特斯拉"},
        {"parent": "tech", "id": "spacex", "en": "SpaceX", "zh": "SpaceX"},
        {"parent": "tech", "id": "neuralink", "en": "Neuralink", "zh": "Neuralink"},
        {"parent": "tech", "id": "boring", "en": "The Boring Company", "zh": "The Boring Company"},
        {"parent": "tech", "id": "xai", "en": "xAI", "zh": "xAI"},
        {"parent": "ai", "id": "grok", "en": "Grok", "zh": "Grok"},
        {"parent": "ai", "id": "fsd", "en": "Full Self-Driving", "zh": "完全自动驾驶"},
        {"parent": "ai", "id": "optimus", "en": "Optimus", "zh": "Optimus"},
        {"parent": "space", "id": "starship", "en": "Starship", "zh": "星舰"},
        {"parent": "space", "id": "falcon", "en": "Falcon", "zh": "猎鹰"},
        {"parent": "space", "id": "dragon", "en": "Dragon", "zh": "龙飞船"},
        {"parent": "space", "id": "mars", "en": "Mars", "zh": "火星"},
        {"parent": "politics", "id": "doge", "en": "DOGE", "zh": "政府效率部"},
        {"parent": "politics", "id": "regulation", "en": "Regulation", "zh": "监管"},
        {"parent": "energy", "id": "solar", "en": "Solar", "zh": "太阳能"},
        {"parent": "energy", "id": "battery", "en": "Battery", "zh": "电池"}
      ]
    },
    "tag_naming_rules": {
      "rule_5_2_1": {
        "name": {
          "en": "Tag Format",
          "zh": "标签格式"
        },
        "description": {
          "en": "Use lowercase letters. Use hyphens for multi-word tags.",
          "zh": "使用小写字母。多词标签使用连字符分隔。"
        },
        "examples": ["artificial-intelligence", "full-self-driving"]
      },
      "rule_5_2_2": {
        "name": {
          "en": "Tag Hierarchy",
          "zh": "标签层级"
        },
        "levels": {
          "level_1": {
            "description": "Core topics",
            "examples": ["tesla", "spacex"]
          },
          "level_2": {
            "description": "Specific topics",
            "examples": ["cybertruck", "starship"]
          },
          "level_3": {
            "description": "Specific events or concepts",
            "examples": ["dojo-supercomputer", "mars-colony"]
          }
        }
      }
    },
    "new_terminology_2025_2026": {
      "rule_5_3_1": {
        "term": "DOGE",
        "full_name": "Department of Government Efficiency",
        "zh": "政府效率部",
        "tags": ["doge", "government-efficiency"]
      },
      "rule_5_3_2": {
        "term": "Grok Heavy",
        "description": "xAI's latest LLM (2025)",
        "zh": "Grok Heavy",
        "tags": ["grok", "grok-heavy", "xai"]
      },
      "rule_5_3_3": {
        "name": {
          "en": "New Terminology Addition Process",
          "zh": "新术语添加流程"
        },
        "steps": [
          "新术语首次出现时创建术语表条目",
          "在一致性规则文档中更新",
          "通知所有编辑人员"
        ]
      }
    }
  },
  "quote_attribution_consistency": {
    "name": {
      "en": "Quote Attribution Consistency",
      "zh": "引语归属一致性"
    },
    "citation_formats": {
      "rule_6_1_1": {
        "source_type": "X/Twitter Post",
        "format": "Elon Musk (@elonmusk) on X, YYYY-MM-DD\nhttps://x.com/elonmusk/status/{tweet-id}"
      },
      "rule_6_1_2": {
        "source_type": "Interview",
        "format": "Elon Musk, Interview with {Interviewer/Publication}, {Platform}, YYYY-MM-DD\n{URL or Archive Link}"
      },
      "rule_6_1_3": {
        "source_type": "Earnings Call",
        "format": "Elon Musk, Tesla Q{N} {Year} Earnings Call, YYYY-MM-DD\n{Transcript URL or SEC Filing Reference}"
      },
      "rule_6_1_4": {
        "source_type": "Speech",
        "format": "Elon Musk, {Event Name}, {Location}, YYYY-MM-DD\n{Video URL or Transcript Link}"
      }
    },
    "context_annotation": {
      "rule_6_2_1": {
        "name": {
          "en": "Quote Context",
          "zh": "引语上下文"
        },
        "requirements": [
          "必须提供引语的完整上下文",
          "标注引语前后的相关内容",
          "说明引语的回答对象或场合"
        ]
      },
      "rule_6_2_2": {
        "name": {
          "en": "Translation Notes",
          "zh": "翻译说明"
        },
        "requirements": [
          "如有翻译，标注原文语言",
          "说明翻译来源（官方/自译）",
          "保留原文中的语气标记"
        ]
      }
    },
    "uncertainty_annotation": {
      "rule_6_3_1": {
        "name": {
          "en": "Speculative Statement Annotation",
          "zh": "推测性声明标注"
        },
        "markers": [
          {"marker": "[推测/Speculation]", "usage": "非确定性声明"},
          {"marker": "[计划/Planned]", "usage": "计划中的项目"},
          {"marker": "[目标/Target]", "usage": "目标性数字"}
        ]
      },
      "rule_6_3_2": {
        "name": {
          "en": "Time Sensitivity Annotation",
          "zh": "时间敏感性标注"
        },
        "markers": [
          {"marker": "[截至/As of YYYY-MM-DD]", "usage": "时效性内容"},
          {"marker": "[已过期/Expired]", "usage": "过时信息"},
          {"marker": "[已更新/Updated YYYY-MM-DD]", "usage": "更新内容"}
        ]
      }
    }
  },
  "consistency_checklist": {
    "name": {
      "en": "Consistency Checklist",
      "zh": "一致性检查清单"
    },
    "translation_consistency": [
      {"id": "cc-tc-1", "en": "Key terms use uniform translation", "zh": "关键术语使用统一翻译"},
