  {"id": "quote_humor_004", "category": "humor", "tags": ["自嘲", "尴尬", "沉默"], "en": {"text": "I'm the king of awkward silences.", "context": "Self-deprecating humor", "source": "Various interviews, 2023"}, "zh": {"text": "我是尴尬沉默之王。", "context": "自嘲式幽默", "source": "多次采访，2023年"}, "style_markers": ["自嘲", "幽默"], "quality_score": 0.80},
  {"id": "quote_humor_005", "category": "humor", "tags": ["银河系漫游指南", "42", "不要恐慌"], "en": {"text": "Don't panic. The answer is 42.", "context": "Hitchhiker's Guide reference", "source": "Various interviews, 2018-2023"}, "zh": {"text": "不要恐慌。答案是42。", "context": "银河系漫游指南引用", "source": "多次采访，2018-2023年"}, "style_markers": ["科幻引用", "幽默"], "quality_score": 0.87},
  {"id": "quote_humor_006", "category": "humor", "tags": ["钢铁侠", "火箭", "流行文化"], "en": {"text": "I am Iron Man. Wait, no, I'm not. But I do build rockets.", "context": "Iron Man comparison", "source": "Various interviews, 2019"}, "zh": {"text": "我是钢铁侠。等等，不是。但我确实造火箭。", "context": "钢铁侠比较", "source": "多次采访，2019年"}, "style_markers": ["流行文化引用", "自嘲"], "quality_score": 0.83},
  {"id": "quote_humor_007", "category": "humor", "tags": ["Cybertruck", "自嘲", "汽车"], "en": {"text": "My favorite car is the one I'm driving right now. No, wait, it's the Cybertruck.", "context": "Car preference joke", "source": "Various interviews, 2023"}, "zh": {"text": "我最喜欢的车是我现在开的那辆。不，等等，是Cybertruck。", "context": "汽车偏好笑话", "source": "多次采访，2023年"}, "style_markers": ["自相矛盾", "幽默"], "quality_score": 0.78},
  {"id": "quote_humor_008", "category": "humor", "tags": ["猫", "名字", "荒诞"], "en": {"text": "I have a cat named after a cat. His name is... wait for it... Meow.", "context": "Pet humor", "source": "Various interviews, 2023"}, "zh": {"text": "我有一只以猫命名的猫。它的名字是……等一下……喵。", "context": "宠物幽默", "source": "多次采访，2023年"}, "style_markers": ["荒诞", "宠物幽默"], "quality_score": 0.75},
  {"id": "quote_humor_009", "category": "humor", "tags": ["最有趣结局", "迷因", "概率"], "en": {"text": "The most entertaining outcome is the most likely.", "context": "Meme-worthy statement", "source": "X/Twitter Post, 2022"}, "zh": {"text": "最有趣的结局就是最可能的结局。", "context": "迷因式声明", "source": "X/Twitter帖子，2022年"}, "style_markers": ["悖论式", "迷因风格"], "quality_score": 0.86},
  {"id": "quote_humor_010", "category": "humor", "tags": ["推文", "马桶", "自嘲"], "en": {"text": "I tweet from the toilet. That's where my best ideas come from.", "context": "Self-deprecating tweet joke", "source": "Various interviews, 2022"}, "zh": {"text": "我在马桶上发推文。我最好的想法都来自那里。", "context": "自嘲式推文笑话", "source": "多次采访，2022年"}, "style_markers": ["自嘲", "荒诞"], "quality_score": 0.79},
  {"id": "quote_humor_011", "category": "humor", "tags": ["猫vs狗", "狗狗币", "双关"], "en": {"text": "I'm not a cat person. I'm a doge person.", "context": "Dogecoin pun", "source": "Various interviews, 2021"}, "zh": {"text": "我不是猫派。我是狗狗派。", "context": "狗狗币双关", "source": "多次采访，2021年"}, "style_markers": ["双关", "加密货币"], "quality_score": 0.82},
  {"id": "quote_humor_012", "category": "humor", "tags": ["SEC", "挑衅", "律师"], "en": {"text": "The SEC can kiss my ass. Wait, I didn't say that. My lawyer said I shouldn't say that.", "context": "SEC joke", "source": "Various interviews, 2020"}, "zh": {"text": "SEC可以亲吻我的屁股。等等，我没这么说。我的律师说我不应该这么说。", "context": "SEC笑话", "source": "多次采访，2020年"}, "style_markers": ["挑衅", "自我纠正"], "quality_score": 0.84},
  {"id": "quote_humor_013", "category": "humor", "tags": ["私有化推文", "420", "自嘲"], "en": {"text": "I once tweeted that I was taking Tesla private at 420. That was... not my best moment.", "context": "Reflecting on the 420 tweet", "source": "Various interviews, 2023"}, "zh": {"text": "我曾经发推说我要以420美元将Tesla私有化。那……不是我最好的时刻。", "context": "回顾420推文", "source": "多次采访，2023年"}, "style_markers": ["自嘲", "回顾"], "quality_score": 0.88},
  {"id": "quote_humor_014", "category": "humor", "tags": ["大脑", "计算机", "睡眠不足"], "en": {"text": "My brain is basically a computer running on very little sleep.", "context": "Self-deprecating tech joke", "source": "Various interviews, 2023"}, "zh": {"text": "我的大脑基本上是一台在很少睡眠下运行的计算机。", "context": "自嘲式技术笑话", "source": "多次采访，2023年"}, "style_markers": ["自嘲", "技术隐喻"], "quality_score": 0.80},
  {"id": "quote_humor_015", "category": "humor", "tags": ["乐趣", "正确方式", "轻松"], "en": {"text": "If you're not having fun, you're doing it wrong.", "context": "Lighthearted advice", "source": "Various interviews, 2022"}, "zh": {"text": "如果你没有在享受乐趣，那你做错了。", "context": "轻松建议", "source": "多次采访，2022年"}, "style_markers": ["轻松", "哲学性"], "quality_score": 0.81},
  {"id": "quote_humor_016", "category": "humor", "tags": ["银河系漫游指南", "不要恐慌", "科幻"], "en": {"text": "The Hitchhiker's Guide to the Galaxy has a lot to teach us. Mostly: don't panic.", "context": "Sci-fi reference", "source": "Various interviews, 2023"}, "zh": {"text": "《银河系漫游指南》有很多东西可以教我们。主要是：不要恐慌。", "context": "科幻引用", "source": "多次采访，2023年"}, "style_markers": ["科幻引用", "智慧"], "quality_score": 0.83},
  {"id": "quote_humor_017", "category": "humor", "tags": ["Twitter改名", "X", "元音字母"], "en": {"text": "I tried to buy a vowel on Twitter. They said no vowels allowed.", "context": "Twitter to X rebrand joke", "source": "X/Twitter Post, 2023"}, "zh": {"text": "我试图在Twitter上买个元音字母。他们说元音字母不允许。", "context": "Twitter改名为X的笑话", "source": "X/Twitter帖子，2023年"}, "style_markers": ["文字游戏", "自嘲"], "quality_score": 0.80},
  {"id": "quote_humor_018", "category": "humor", "tags": ["睡眠", "作息", "创意"], "en": {"text": "My sleep schedule is... creative. Let's call it creative.", "context": "Sleep joke", "source": "Various interviews, 2023"}, "zh": {"text": "我的作息时间……很有创意。我们就叫它有创意吧。", "context": "睡眠笑话", "source": "多次采访，2023年"}, "style_markers": ["自嘲", "委婉"], "quality_score": 0.78},
  {"id": "quote_humor_019", "category": "humor", "tags": ["酷东西", "悖论", "自嘲"], "en": {"text": "The best thing about being me is that I get to build cool stuff. The worst thing is... also that I get to build cool stuff.", "context": "Self-reflective humor", "source": "Various interviews, 2024"}, "zh": {"text": "做我最好的事情是我能建造酷东西。最坏的事情也是……我能建造酷东西。", "context": "自我反思式幽默", "source": "多次采访，2024年"}, "style_markers": ["悖论式", "自嘲"], "quality_score": 0.82},
  {"id": "quote_humor_020", "category": "humor", "tags": ["迷因", "自我认知", "接受"], "en": {"text": "I'm basically a meme at this point. I've accepted it.", "context": "Self-aware meme reference", "source": "Various interviews, 2024"}, "zh": {"text": "我现在基本上就是一个迷因了。我已经接受了。", "context": "自我认知的迷因引用", "source": "多次采访，2024年"}, "style_markers": ["自嘲", "接受"], "quality_score": 0.85}
]
