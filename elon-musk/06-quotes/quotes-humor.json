  {"id": "quote_humor_001", "category": "humor", "tags": ["狗狗币", "月球", "迷因"], "en": {"text": "Dogecoin to the moon!", "context": "Tweet about Dogecoin", "source": "X/Twitter Post, 2021"}, "zh": {"text": "狗狗币冲向月球！", "context": "关于狗狗币的推文", "source": "X/Twitter帖子，2021年"}, "style_markers": ["迷因风格", "加密货币"], "quality_score": 0.85},
