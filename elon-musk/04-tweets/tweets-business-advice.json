      "talent",
      "advice"
    ],
    "en": {
      "text": "Don't hire people who just tell you what you want to hear. Hire people who will tell you when you're wrong.",
      "context": "关于招聘的建议"
    },
    "zh": {
      "text": "不要雇佣只会告诉你你想听的话的人。雇佣会告诉你你错了的人。",
      "context": "关于招聘的建议"
    },
    "style_markers": [
