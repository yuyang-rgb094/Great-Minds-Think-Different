      }
    },
    "category": "business-advice",
    "tags": [
      "product",
      "customer",
      "feedback"
    ],
    "en": {
      "text": "The best product is the one that makes itself. Word of mouth is the most powerful marketing.",
      "context": "关于产品和营销的建议"
    },
    "zh": {
      "text": "最好的产品是能自我推销的产品。口碑是最强大的营销。",
      "context": "关于产品和营销的建议"
    },
    "style_markers": [
      "advisory",
      "business",
      "practical"
    ],
    "quality_score": 0.92
  },
  {
    "id": "tweet_business-advice_004",
    "source": {
      "type": "tweet",
      "date": "2023-05-15",
      "engagement": {
        "likes": 310000,
        "retweets": 38000,
        "replies": 25000,
        "views": 74000000
      }
    },
    "category": "business-advice",
    "tags": [
      "risk",
      "startup",
      "courage"
    ],
    "en": {
      "text": "Starting a company is like eating glass and staring into the abyss. But once you succeed, it's worth it.",
      "context": "关于创业艰辛的描述"
    },
    "zh": {
      "text": "创业就像吃玻璃和凝视深渊。但一旦你成功了，一切都是值得的。",
      "context": "关于创业艰辛的描述"
    },
    "style_markers": [
      "raw",
      "honest",
      "entrepreneurial"
    ],
    "quality_score": 0.95
  },
  {
    "id": "tweet_business-advice_005",
    "source": {
      "type": "tweet",
      "date": "2023-07-20",
      "engagement": {
        "likes": 290000,
        "retweets": 35000,
        "replies": 23000,
        "views": 70000000
      }
    },
    "category": "business-advice",
    "tags": [
      "communication",
      "management",
      "advice"
    ],
    "en": {
      "text": "In meetings, walk out if you're not adding value. Your time is better spent building things.",
      "context": "关于会议效率的建议"
    },
    "zh": {
      "text": "在会议中，如果你没有增加价值就走出去。你的时间最好花在构建东西上。",
      "context": "关于会议效率的建议"
    },
    "style_markers": [
      "direct",
      "practical",
      "efficiency"
    ],
    "quality_score": 0.89
  },
  {
    "id": "tweet_business-advice_006",
    "source": {
      "type": "tweet",
      "date": "2023-09-15",
      "engagement": {
        "likes": 270000,
